  m_Name: BenSmallTalk2
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  lines:
  - Magandang umaga!
  - Ah, oo. Pupunta akong palengke.
  - Nako, wala na.
  - Nabanggit kasi ng mama mo na naghahanap daw ng driver yung bigasan.
  - Buti nalang at kinuha ako.
  - Wala eh.
  - Mas malaki pa gastos ko sa pataba kaysa sa kita.
  linesToAutoProgress: 00000101000100
  endLines: 00000000000001
