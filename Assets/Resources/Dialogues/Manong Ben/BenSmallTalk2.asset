  typingSpeed: 0.05
  dialogueType: 0
  choices:
  - dialogueIndex: 0
    choices:
    - Magandang umaga rin po, Tito. Ang aga niyo po ata ngayon?
    nextDialogueIndices: 01000000
  - dialogueIndex: 1
    choices:
    - May mga ilalako na po ulit kayo?
    nextDialogueIndices: 02000000
  - dialogueIndex: 4
    choices:
    - Ah, mabuti naman po. Paano po pala yung mga pananim niyo?
    nextDialogueIndices: 05000000
