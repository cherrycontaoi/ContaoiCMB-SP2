  dialogueType: 0
  choices:
  - dialogueIndex: 1
    choices:
    - May mga ilalako na po ulit kayo?
    nextDialogueIndices: 02000000
  - dialogueIndex: 3
    choices:
    - Ah, talaga po?
    nextDialogueIndices: 04000000
  - dialogueIndex: 4
    choices:
    - Paano po yung mga tanim ninyo?
